{
  "name": "slice",
  "version": "2.0.0",
  "description": "Slice connects hospital near-miss reports into patient-safety signals using the Swiss cheese model. An Atlassian Forge app for Jira, Confluence and Rovo.",
  "keywords": [
    "atlassian",
    "forge",
    "jira",
    "confluence",
    "rovo",
    "patient-safety",
    "healthcare",
    "near-miss",
    "swiss-cheese-model",
    "codegeist"
  ],
  "author": "Mobassirul islam Yasin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasinDoc/slice.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --experimental-test-module-mocks --test tests/*.test.js",
    "demo": "node scripts/demo.js",
    "seed": "node scripts/seed.js",
    "dedupe": "node scripts/remove-duplicates.js",
    "lint": "forge lint"
  },
  "engines": {
    "node": ">=22.3"
  },
  "dependencies": {
    "@forge/api": "^7.0.0",
    "@forge/bridge": "^5.0.0",
    "@forge/kvs": "^1.0.0",
    "@forge/react": "^11.0.0",
    "@forge/resolver": "^1.6.0",
    "react": "^18.3.1"
  }
}
